<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 
        Package/namespace defined in build.gradle as 'com.lingualink.linguagt'
        AGP 8.x no longer supports the package attribute here
    -->

    <!-- CRITICAL: Microphone permissions for voice translation -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Chrome media layer requires Bluetooth permission for audio device enumeration -->
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <!-- IMA SDK: Required for advertising ID access -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    
    <!-- Optional: Improves ad targeting -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Google Play Billing for premium subscriptions -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- CRITICAL: Declare microphone as optional for devices without microphone -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Declare audio output feature -->
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="false" />

    <application
        android:name="com.linguawonder.app.LinguaLinkApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_globe"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="false"
        tools:targetApi="35">

        <!-- AdMob Application ID — replace with your real LinguaWonder AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id"/>

        <!-- FIX: Disable Firebase auto-initialization to prevent blocking main thread on startup -->
        <!-- Firebase will be manually initialized after WebView is ready -->
        <meta-data
            android:name="firebase_analytics_collection_deferred"
            android:value="true"/>
        
        <!-- Disable Firebase Crashlytics auto-collection (if present) -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false"/>
        
        <!-- Disable Firebase Performance auto-collection (if present) -->
        <meta-data
            android:name="firebase_performance_collection_deferred"
            android:value="true"/>

        <!-- Privacy Sandbox Ad Services Config - resolve conflict between play-services-ads and measurement -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- Main Activity with proper configuration changes -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:alwaysRetainTaskState="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|uiMode|density|touchscreen">

            <!-- Main launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links (verified deep linking) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gtlingua.com" />
                <data android:scheme="https" android:host="www.gtlingua.com" />
            </intent-filter>

            <!-- Custom scheme fallback (no verification needed) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linguagt" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Translation Service with microphone foreground service type -->
        <service
            android:name=".TranslationService"
            android:enabled="true"
            android:exported="false" 
            android:foregroundServiceType="microphone"
            tools:targetApi="29" />

        <!-- AdMob AdActivity (REQUIRED for interstitial/rewarded ads) -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent"
            android:hardwareAccelerated="true"
            android:exported="false" />
    </application>
</manifest>