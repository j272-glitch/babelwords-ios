<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">

    <!-- Main WebView for the translation app -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:contentDescription="LinguaLink Translation App WebView"
        android:scrollbars="none" />

    <!-- Loading indicator overlay -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/white"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true"
            style="?android:attr/progressBarStyle" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_translation_app"
            android:textSize="16sp"
            android:textColor="@android:color/darker_gray" />

        <TextView
            android:id="@+id/loading_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/initializing_conversation_mode"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- Error/Fallback container -->
    <LinearLayout
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@android:color/white"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:tint="@android:color/darker_gray"
            android:contentDescription="@string/error_icon" />

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/connection_error"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/connection_error_message"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/retry"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:paddingHorizontal="32dp" />

        <Button
            android:id="@+id/offline_mode_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/use_offline_mode"
            android:textColor="@android:color/holo_blue_dark"
            android:backgroundTint="@android:color/transparent"
            android:paddingHorizontal="32dp"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- Permission request overlay -->
    <LinearLayout
        android:id="@+id/permission_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/microphone_permission_required"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/microphone_permission_description"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <Button
            android:id="@+id/grant_permission_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grant_permission"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_blue_dark" />
    </LinearLayout>

    <!-- Conversation mode indicator -->
    <LinearLayout
        android:id="@+id/conversation_mode_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:background="#E8F5E9"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="2dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/presence_audio_online"
            android:tint="#4CAF50"
            android:contentDescription="@string/conversation_mode_active" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/conversation_mode"
            android:textSize="12sp"
            android:textColor="#2E7D32" />
    </LinearLayout>

    <!-- Progress bar for page loading -->
    <ProgressBar
        android:id="@+id/webview_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentTop="true"
        android:progressTint="@android:color/holo_blue_dark"
        android:visibility="gone"
        android:indeterminate="false"
        android:max="100" />

    <!-- 
    ====================================================================
    UNITY LEVELPLAY AD BANNER PLACEHOLDER (Optional - Currently unused)
    ====================================================================
    Interstitial ads are used instead of banner ads for better UX.
    Uncomment below if you want to add banner ads later.

    <FrameLayout
        android:id="@+id/ad_banner_container"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/darker_gray"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Ad Space"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </FrameLayout>
    -->

</RelativeLayout>
