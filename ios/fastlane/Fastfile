default_platform(:ios)

# Match repo URL can be overridden via FASTLANE_MATCH_REPO_URL.
match_repo_url = ENV["FASTLANE_MATCH_REPO_URL"] || "https://github.com/j272-glitch/babelwords-match.git"

platform :ios do
  desc "Sync signing certificates and provisioning profiles"
  lane :sync_signing do
    match(
      type: "appstore",
      app_identifier: "com.babelwords.com",
      git_url: match_repo_url,
      readonly: false,
      api_key_path: "./app_store_connect_api_key.json"
    )
  end

  desc "Build and export App Store IPA"
  lane :build do
    sync_signing
    gym(
      scheme: "BabelWords",
      workspace: "BabelWords.xcworkspace",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "BabelWords.ipa"
    )
  end
end
