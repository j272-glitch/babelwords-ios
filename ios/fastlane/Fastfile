default_platform(:ios)

# Replace the match repo URL or set the FASTLANE_MATCH_REPO_URL environment variable.
match_repo_url = ENV["FASTLANE_MATCH_REPO_URL"] || "https://github.com/YOUR_ORG/linguavibe-match.git"

platform :ios do
  desc "Sync signing certificates and provisioning profiles"
  lane :sync_signing do
    match(
      type: "appstore",
      app_identifier: "com.babelwords.LinguaVibe",
      git_url: match_repo_url,
      readonly: false,
      api_key_path: "./app_store_connect_api_key.json"
    )
  end

  desc "Build and export App Store IPA"
  lane :build do
    sync_signing
    gym(
      scheme: "LinguaVibe",
      workspace: "LinguaVibe.xcworkspace",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "LinguaVibe.ipa"
    )
  end
end
