plugins {
    id 'com.android.application'
    id 'org.jetbrains.kotlin.android'
}

android {
    namespace 'com.lingualink.linguagt'
    compileSdk 35

    defaultConfig {
        applicationId "com.lingualink.linguagt"
        minSdk 24
        targetSdk 35
        versionCode 10
        versionName "10.0.0"

        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
        
        // WebView configuration
        buildConfigField "String", "BASE_URL", "\"https://linguagt.com\""
    }

    signingConfigs {
        release {
            // These come from environment variables in CI/CD
            if (System.getenv("ANDROID_KEYSTORE_PASSWORD")) {
                storeFile file("release.keystore")
                storePassword System.getenv("ANDROID_KEYSTORE_PASSWORD")
                keyAlias System.getenv("ANDROID_KEY_ALIAS")
                keyPassword System.getenv("ANDROID_KEY_PASSWORD")
            }
        }
    }

    buildTypes {
        debug {
            debuggable true
            minifyEnabled false
        }
        release {
            debuggable false
            minifyEnabled false  // DISABLED for TestRigor compatibility
            shrinkResources false // DISABLED for TestRigor compatibility
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
            
            // Use release signing if available
            if (System.getenv("ANDROID_KEYSTORE_PASSWORD")) {
                signingConfig signingConfigs.release
            }
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    kotlinOptions {
        jvmTarget = '17'
    }

    buildFeatures {
        buildConfig = true
    }

    // Prevent duplicate file issues
    packagingOptions {
        resources {
            excludes += '/META-INF/{AL2.0,LGPL2.1}'
            excludes += 'META-INF/DEPENDENCIES'
            excludes += 'META-INF/LICENSE'
            excludes += 'META-INF/LICENSE.txt'
            excludes += 'META-INF/NOTICE'
            excludes += 'META-INF/NOTICE.txt'
        }
    }
}

// ==================== ISSUE #8 FIX: DEPENDENCY CONFLICT RESOLUTION ====================
configurations.all {
    resolutionStrategy {
        // Force specific AndroidX versions to prevent conflicts
        force 'androidx.core:core-ktx:1.12.0'
        force 'androidx.appcompat:appcompat:1.6.1'
        force 'androidx.activity:activity-ktx:1.8.2'
        force 'androidx.fragment:fragment-ktx:1.6.2'
        
        // Force Kotlin stdlib version to match Kotlin plugin
        force 'org.jetbrains.kotlin:kotlin-stdlib:1.9.24'
        force 'org.jetbrains.kotlin:kotlin-stdlib-jdk8:1.9.24'
        
        // Force coroutines version
        force 'org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3'
        force 'org.jetbrains.kotlinx:kotlinx-coroutines-core:1.7.3'
        
        // Force lifecycle versions to be consistent
        force 'androidx.lifecycle:lifecycle-runtime-ktx:2.7.0'
        force 'androidx.lifecycle:lifecycle-viewmodel-ktx:2.7.0'
        force 'androidx.lifecycle:lifecycle-livedata-ktx:2.7.0'
        
        // Force annotation version (common conflict point)
        force 'androidx.annotation:annotation:1.7.1'
        
        // Prefer modules over jars for better conflict resolution
        preferProjectModules()
        
        // Fail fast on version conflict during build
        failOnVersionConflict()
        
        // Log dependency resolution issues
        eachDependency { details ->
            if (details.requested.group == 'androidx.core' && details.requested.name == 'core-ktx') {
                if (details.requested.version != '1.12.0') {
                    details.because "Force androidx.core:core-ktx to 1.12.0 to prevent conflicts"
                    details.useVersion '1.12.0'
                }
            }
            
            if (details.requested.group == 'org.jetbrains.kotlin' && details.requested.name.startsWith('kotlin-stdlib')) {
                if (details.requested.version != '1.9.24') {
                    details.because "Force Kotlin stdlib to 1.9.24 to match plugin version"
                    details.useVersion '1.9.24'
                }
            }
        }
    }
}

dependencies {
    // ==================== CORE ANDROID ====================
    implementation 'androidx.core:core-ktx:1.12.0'
    implementation 'androidx.appcompat:appcompat:1.6.1'
    implementation 'com.google.android.material:material:1.11.0'
    implementation 'androidx.constraintlayout:constraintlayout:2.1.4'
    
    // ==================== LIFECYCLE ====================
    implementation 'androidx.lifecycle:lifecycle-runtime-ktx:2.7.0'
    implementation 'androidx.lifecycle:lifecycle-process:2.7.0'
    implementation 'androidx.lifecycle:lifecycle-common-java8:2.7.0'
    
    // ==================== ACTIVITY ====================
    implementation 'androidx.activity:activity-ktx:1.8.2'
    
    // ==================== WEBKIT (for WebView enhancements) ====================
    implementation 'androidx.webkit:webkit:1.10.0'
    
    // ==================== COROUTINES ====================
    implementation 'org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3'
    implementation 'org.jetbrains.kotlinx:kotlinx-coroutines-core:1.7.3'
    
    // ==================== GOOGLE ADS (AdMob) ====================
    // ENABLED - Required for AdMobHelper, AdPreloader, AdUnitValidator, DefaultAdCallbacks
    implementation 'com.google.android.gms:play-services-ads:23.5.0'
    
    // ==================== SECURITY ====================
    implementation 'androidx.security:security-crypto:1.1.0-alpha06'
    
    // ==================== NETWORKING (if needed) ====================
    implementation 'com.squareup.okhttp3:okhttp:4.12.0'
    implementation 'com.squareup.okhttp3:logging-interceptor:4.12.0'
    implementation 'com.squareup.retrofit2:retrofit:2.9.0'
    implementation 'com.squareup.retrofit2:converter-gson:2.9.0'
    implementation 'com.google.code.gson:gson:2.10.1'
    
    // ==================== TESTING ====================
    testImplementation 'junit:junit:4.13.2'
    androidTestImplementation 'androidx.test.ext:junit:1.1.5'
    androidTestImplementation 'androidx.test.espresso:espresso-core:3.5.1'
}

// ==================== DEPENDENCY VERIFICATION TASK ====================
tasks.register('verifyDependencies') {
    doLast {
        println("\n" + "=".repeat(60))
        println("Dependency Verification")
        println("=".repeat(60))
        println("Checking for known conflicts...")
        println("✓ AndroidX Core: 1.12.0 (forced)")
        println("✓ Kotlin Stdlib: 1.9.24 (forced)")
        println("✓ Coroutines: 1.7.3 (forced)")
        println("✓ Lifecycle: 2.7.0 (forced)")
        println("=".repeat(60))
        println("Run './gradlew app:dependencies' for full dependency tree")
        println("=".repeat(60) + "\n")
    }
}
