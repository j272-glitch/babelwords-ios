<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.lingualink.linguagt">
    
    <!-- Required permissions for speech translation and conversation mode -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- Ad-related permissions - REQUIRED for Google AdMob -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    
    <application
        android:name="com.lingualink.linguagt.LinguaLinkApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_globe"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">
        
        <!-- ========================================= -->
        <!-- Google AdMob App ID - REQUIRED           -->
        <!-- ========================================= -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9277938970928959~7782802034"/>
        
        <!-- ========================================= -->
        <!-- AdMob Delay App Measurement (Optional)   -->
        <!-- Allows manual initialization control     -->
        <!-- ========================================= -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true"/>
        
        <!-- ========================================= -->
        <!-- Main Activity - Conversation Mode        -->
        <!-- ========================================= -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|uiMode|density|touchscreen">
            
            <!-- Main launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Deep linking intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data 
                    android:scheme="https"
                    android:host="linguagt.com"
                    android:pathPrefix="/translate" />
            </intent-filter>
        </activity>
        
        <!-- ========================================= -->
        <!-- Google AdMob Interstitial Ad Activity    -->
        <!-- Using default theme from Play Services   -->
        <!-- ========================================= -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false" />
        
        <!-- ========================================= -->
        <!-- Google AdMob Full Screen Content         -->
        <!-- For Rewarded & Interstitial Ads         -->
        <!-- Using default theme from Play Services   -->
        <!-- ========================================= -->
        <activity
            android:name="com.google.android.gms.ads.FullScreenContentActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false" />
        
        <!-- ========================================= -->
        <!-- Unity Ads Activity (If Using Mediation)  -->
        <!-- ========================================= -->
        <activity
            android:name="com.unity3d.ads.UnityAdsActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|locale|mnc|mcc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|touchscreen"
            android:theme="@style/UnityAdsTheme"
            android:exported="false" />
        
        <!-- ========================================= -->
        <!-- Unity Ads Mediation Service (Optional)   -->
        <!-- ========================================= -->
        <service
            android:name="com.unity3d.services.ads.UnityAdsService"
            android:enabled="true"
            android:exported="false" />
        
        <!-- ========================================= -->
        <!-- Speech Translation Service               -->
        <!-- ========================================= -->
        <service
            android:name=".TranslationService"
            android:enabled="true"
            android:exported="false" 
            android:foregroundServiceType="microphone"
            tools:targetApi="29" />
        
    </application>
</manifest>
