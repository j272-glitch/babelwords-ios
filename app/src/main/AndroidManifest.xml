<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- 
        IMPORTANT: Package/namespace is now defined in build.gradle as 'com.lingualink.linguagt'
        AGP 8.x no longer supports the package attribute in AndroidManifest.xml
        Version code and version name are also defined in build.gradle
    -->
    
    <!-- Required permissions for speech translation and conversation mode -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <application
        android:name="com.lingualink.linguagt.LinguaLinkApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_globe"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">
        
        <!-- Main Activity - Properly configured for launch with conversation mode support -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|uiMode|density|touchscreen">
            
            <!-- Main launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- Deep linking intent filter (optional) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data 
                    android:scheme="https"
                    android:host="linguagt.com"
                    android:pathPrefix="/translate" />
            </intent-filter>
        </activity>
        
        <!-- Speech Translation Service with conversation mode support -->
        <service
            android:name=".TranslationService"
            android:enabled="true"
            android:exported="false" 
            android:foregroundServiceType="microphone"
            tools:targetApi="29" />
        
        <!-- AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9277938970928959~7782802034"/>
    </application>
</manifest>
