<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>LinguaLink Speech Translator</title>
    <meta name="description" content="Real-time speech translation app with voice recognition and text-to-speech. Translate spoken words instantly between 10+ languages including English, Spanish, French, German, and more." />
    <meta name="keywords" content="speech translator, voice translator, real-time translation, speech recognition, text-to-speech, language translator" />
    
    <!-- Open Graph tags for social sharing -->
    <meta property="og:title" content="LinguaLink Speech Translator" />
    <meta property="og:description" content="Real-time speech translation with voice recognition. Translate spoken words instantly between multiple languages." />
    <meta property="og:type" content="website" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json">
    
    <!-- Apple Web App settings -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="LinguaLink" />
    <meta name="apple-touch-fullscreen" content="yes">
    
    <!-- Theme Color -->
    <meta name="theme-color" content="#4F46E5">
    <meta name="msapplication-TileColor" content="#4F46E5">
    
    <!-- Additional PWA Meta -->
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LinguaLink">
    <script type="module" crossorigin src="/assets/index-DM_DQ2Ef.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-BGVejc7c.css">
  </head>
  <body>
    <div id="root"></div>
    
    <!-- PWA Service Worker Registration -->
    <script>
      // Register Service Worker for PWA
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js")
            .then(registration => {
              console.log("LinguaLink SW registered: ", registration);
            })
            .catch(registrationError => {
              console.log("LinguaLink SW registration failed: ", registrationError);
            });
        });
      }

      // PWA Install prompt
      let deferredPrompt;
      window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        deferredPrompt = e;
        console.log("LinguaLink PWA install prompt available");
      });
    </script>
    
    <!-- This is a replit script which adds a banner on the top of the page when opened in development mode outside the replit environment -->
    <script type="text/javascript" src="https://replit.com/public/js/replit-dev-banner.js"></script>
  </body>
</html>