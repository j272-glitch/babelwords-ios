// REFERENCE: Minimum build.gradle for skeleton app
// Compare against your app/build.gradle to ensure these are present

plugins {
    id 'com.android.application'
    id 'org.jetbrains.kotlin.android'
}

android {
    namespace 'com.lingualink.linguagt'
    compileSdk 35

    defaultConfig {
        applicationId "com.lingualink.linguagt"
        minSdk 24
        targetSdk 35
        versionCode 1
        versionName "1.0"
    }

    buildTypes {
        release {
            minifyEnabled false  // IMPORTANT: Disable for testing
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }
    
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
    
    kotlinOptions {
        jvmTarget = '17'
    }
}

dependencies {
    // MINIMUM REQUIRED - nothing else needed for skeleton
    implementation 'androidx.core:core-ktx:1.12.0'
    
    // NOTE: AppCompatActivity NOT required for skeleton
    // The skeleton uses plain Activity which is built into Android
}

// KEY THINGS TO CHECK:
// 1. namespace must match package in Kotlin files
// 2. minifyEnabled false (ProGuard can strip classes and cause "class not found")
// 3. No missing dependencies that would cause runtime crashes
